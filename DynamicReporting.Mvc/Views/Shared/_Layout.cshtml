<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - DynamicReporting.Mvc</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>


<body class="min-h-screen flex flex-col bg-base-200 text-base-content">


    <header>

        <div class="navbar bg-base-100 shadow-md px-4 mb-6">

            <div class="flex-1">

                <!-- Brand -->
                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-ghost text-xl">

                    DynamicReporting.Mvc

                </a>

            </div>


            <div class="flex-none">

                <ul class="menu menu-horizontal px-1">

                    <li>
                        <a asp-area=""
                           asp-controller="Home"
                           asp-action="Index">

                            Home

                        </a>
                    </li>


                    <li>
                        <a asp-area=""
                           asp-controller="Home"
                           asp-action="Privacy">

                            Privacy

                        </a>
                    </li>

                </ul>

            </div>


        </div>


    </header>


    <main role="main"
          class="flex-1 container mx-auto px-4 pb-6">


        @RenderBody()


    </main>


    <footer class="footer footer-center bg-base-100 text-base-content p-4 border-t">


        <aside>

            <p>
                &copy; 1405 - DynamicReporting.Mvc -

                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Privacy"
                   class="link link-primary">

                    Privacy

                </a>

            </p>


        </aside>


    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>


    @await RenderSectionAsync("Scripts", false)


</body>

</html>