<!DOCTYPE html>
<html lang="fa" dir="rtl" data-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Dynamic Reporting</title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body class="min-h-screen bg-base-200 text-base-content">

    <!-- Navbar -->
    <header class="sticky top-0 z-50">

        <div class="navbar bg-base-100 shadow-sm px-4 lg:px-8">

            <!-- Right side -->
            <div class="navbar-start">

                <!-- Mobile menu -->
                <div class="dropdown">

                    <div tabindex="0"
                         role="button"
                         class="btn btn-ghost btn-circle lg:hidden"
                         aria-label="باز کردن منو">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             class="h-6 w-6"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke="currentColor">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M4 6h16M4 12h16M4 18h16" />

                        </svg>

                    </div>


                    <ul tabindex="0"
                        class="menu menu-sm dropdown-content bg-base-100 rounded-box z-50 mt-3 w-64 p-2 shadow-lg">

                        <!-- Home -->
                        <li>
                            <a asp-controller="Home"
                               asp-action="Index"
                               class="font-medium">

                                <svg xmlns="http://www.w3.org/2000/svg"
                                     class="h-5 w-5 text-primary"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke="currentColor">

                                    <path stroke-linecap="round"
                                          stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M3 12l9-9 9 9M5 10v10h14V10" />

                                </svg>

                                خانه

                            </a>
                        </li>


                        <!-- Reports -->
                        <li>

                            <details>

                                <summary>

                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         class="h-5 w-5"
                                         fill="none"
                                         viewBox="0 0 24 24"
                                         stroke="currentColor">

                                        <path stroke-linecap="round"
                                              stroke-linejoin="round"
                                              stroke-width="2"
                                              d="M3 3v18h18M7 16v-5M12 16V7M17 16v-8" />

                                    </svg>

                                    گزارش‌ها

                                </summary>

                                <ul>

                                    <li>
                                        <a asp-controller="Reports"
                                           asp-action="Index">

                                            گزارش ساز

                                        </a>
                                    </li>

                                    <li>
                                        <a asp-controller="ReportGenerated"
                                           asp-action="GeneratedReports">

                                            گزارش‌های ایجاد شده

                                        </a>
                                    </li>

                                </ul>

                            </details>

                        </li>


                        <!-- Metadata -->
                        <li>

                            <details>

                                <summary>

                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         class="h-5 w-5"
                                         fill="none"
                                         viewBox="0 0 24 24"
                                         stroke="currentColor">

                                        <path stroke-linecap="round"
                                              stroke-linejoin="round"
                                              stroke-width="2"
                                              d="M4 6h16M4 12h16M4 18h16" />

                                    </svg>

                                    داده‌ها

                                </summary>

                                <ul>

                                    <li>
                                        <a asp-controller="ReportMetadata"
                                           asp-action="Index">

                                            جداول

                                        </a>
                                    </li>

                                    <li>
                                        <a asp-controller="ReportMetadata"
                                           asp-action="AllMetadata">

                                            متادیتای جداول

                                        </a>
                                    </li>

                                </ul>

                            </details>

                        </li>


                        <!-- About -->
                        <li>

                            <a asp-controller="Home"
                               asp-action="About">

                                <svg xmlns="http://www.w3.org/2000/svg"
                                     class="h-5 w-5"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke="currentColor">

                                    <path stroke-linecap="round"
                                          stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M13 16h-1v-4h-1m1-8a9 9 0 100 18 9 9 0 000-18zm0 5h.01" />

                                </svg>

                                درباره ما

                            </a>

                        </li>

                    </ul>

                </div>


                <!-- Logo -->
                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-ghost text-xl font-bold">

                    <span class="text-primary">
                        Reporting

                    </span>

                    <span>
                        Dynamic
                    </span>

                </a>

            </div>


            <!-- Desktop menu -->
            <div class="navbar-center hidden lg:flex">

                <ul class="menu menu-horizontal px-1 gap-1">

                    <!-- Home -->
                    <li>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="font-medium">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 class="h-5 w-5"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor">

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M3 12l9-9 9 9M5 10v10h14V10" />

                            </svg>

                            خانه

                        </a>

                    </li>


                    <!-- Reports -->
                    <li>

                        <details>

                            <summary class="font-medium">

                                <svg xmlns="http://www.w3.org/2000/svg"
                                     class="h-5 w-5"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke="currentColor">

                                    <path stroke-linecap="round"
                                          stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M3 3v18h18M7 16v-5M12 16V7M17 16v-8" />

                                </svg>

                                گزارش‌ها

                            </summary>

                            <ul class="bg-base-100 rounded-box w-56 p-2 shadow-lg">

                                <li>
                                    <a asp-controller="Reports"
                                       asp-action="Index">

                                        گزارش ساز

                                    </a>
                                </li>

                                <li>
                                    <a asp-controller="ReportGenerated"
                                       asp-action="GeneratedReports">

                                        گزارش‌های ایجاد شده

                                    </a>
                                </li>

                            </ul>

                        </details>

                    </li>


                    <!-- Metadata -->
                    <li>

                        <details>

                            <summary class="font-medium">

                                <svg xmlns="http://www.w3.org/2000/svg"
                                     class="h-5 w-5"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke="currentColor">

                                    <path stroke-linecap="round"
                                          stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M4 6h16M4 12h16M4 18h16" />

                                </svg>

                                داده‌ها

                            </summary>

                            <ul class="bg-base-100 rounded-box w-56 p-2 shadow-lg">

                                <li>
                                    <a asp-controller="ReportMetadata"
                                       asp-action="Index">

                                        جداول

                                    </a>
                                </li>

                                <li>
                                    <a asp-controller="ReportMetadata"
                                       asp-action="AllMetadata">

                                        متادیتای جداول

                                    </a>
                                </li>

                            </ul>

                        </details>

                    </li>


                    <!-- About -->
                    <li>

                        <a asp-controller="Home"
                           asp-action="About"
                           class="font-medium">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 class="h-5 w-5"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor">

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M13 16h-1v-4h-1m1-8a9 9 0 100 18 9 9 0 000-18zm0 5h.01" />

                            </svg>

                            درباره ما

                        </a>

                    </li>

                </ul>

            </div>


            <!-- Left side -->
            <div class="navbar-end">

                <div class="hidden sm:flex items-center justify-center
                w-10 h-10 rounded-xl
                bg-primary/10 text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         class="w-6 h-6"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke="currentColor">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M4 19V5
                     M4 19h16
                     M7 15l3-4 3 2 4-6" />

                    </svg>

                </div>

            </div>

        </div>

    </header>


    <!-- Main -->
    <main class="min-h-[calc(100vh-140px)]">

        @RenderBody()

    </main>


    <!-- Footer -->
    <footer class="footer footer-center bg-base-100 text-base-content border-t p-6">

        <aside>

            <p class="text-sm">

                © 1405

                <span class="font-semibold">
                    Dynamic Reporting
                </span>

                — تمامی حقوق محفوظ است.

            </p>

        </aside>

    </footer>


    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", false)

</body>

</html>