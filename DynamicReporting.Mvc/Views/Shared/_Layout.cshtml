<!DOCTYPE html>
<html lang="fa" dir="rtl" data-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Dynamic Reporting</title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body class="min-h-screen bg-base-200 text-base-content">

    <!-- Navbar -->
    <header class="sticky top-0 z-50">

        <div class="navbar bg-base-100 shadow-sm px-4 lg:px-8">

            <!-- Mobile menu -->
            <div class="navbar-start">

                <div class="dropdown">

                    <div tabindex="0"
                         role="button"
                         class="btn btn-ghost btn-circle lg:hidden">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             class="h-6 w-6"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke="currentColor">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M4 6h16M4 12h16M4 18h16" />

                        </svg>

                    </div>

                    <ul tabindex="0"
                        class="menu menu-sm dropdown-content bg-base-100 rounded-box z-50 mt-3 w-56 p-2 shadow-lg">

                        <li>
                            <a asp-controller="Home"
                               asp-action="Index">
                                خانه
                            </a>
                        </li>

                        <li>
                            <a asp-controller="ReportMetadata"
                               asp-action="Index">
                                جداول
                            </a>
                        </li>

                        <li>
                            <a asp-controller="ReportMetadata"
                               asp-action="AllMetadata">
                                متادیتای جداول
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Home"
                               asp-action="Privacy">
                                حریم خصوصی
                            </a>
                        </li>

                    </ul>

                </div>

                <!-- Logo -->
                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-ghost text-xl font-bold">

                    <span class="text-primary">
                        Dynamic
                    </span>

                    <span>
                        Reporting
                    </span>

                </a>

            </div>


            <!-- Desktop menu -->
            <div class="navbar-center hidden lg:flex">

                <ul class="menu menu-horizontal px-1 gap-1">

                    <li>
                        <a asp-controller="Home"
                           asp-action="Index"
                           class="font-medium">

                            خانه

                        </a>
                    </li>


                    <li>
                        <a asp-controller="Reports"
                           asp-action="Index"
                           class="font-medium">

                            گزارش ساز

                        </a>
                    </li>

                    <li>
                        <a asp-controller="ReportMetadata"
                           asp-action="Index"
                           class="font-medium">

                            جداول

                        </a>
                    </li>


                    <li>

                        <details>

                            <summary class="font-medium">
                                گزارش‌ها
                            </summary>

                            <ul class="bg-base-100 rounded-box w-56 p-2 shadow-lg">

                                <li>
                                    <a asp-controller="ReportMetadata"
                                       asp-action="AllMetadata">

                                        متادیتای تمام جداول

                                    </a>
                                </li>

                            </ul>

                        </details>

                    </li>


                    <li>

                        <a asp-controller="Home"
                           asp-action="Privacy"
                           class="font-medium">

                            حریم خصوصی

                        </a>

                    </li>

                </ul>

            </div>


            <!-- Right side -->
            <div class="navbar-end">

                <div class="badge badge-primary badge-outline hidden sm:flex">
                    Dynamic Reporting
                </div>

            </div>

        </div>

    </header>


    <!-- Main -->
    <main class="min-h-[calc(100vh-140px)]">

        @RenderBody()

    </main>


    <!-- Footer -->
    <footer class="footer footer-center bg-base-100 text-base-content border-t p-6">

        <aside>

            <p class="text-sm">

                © 1405

                <span class="font-semibold">
                    Dynamic Reporting
                </span>

                — تمامی حقوق محفوظ است.

            </p>

        </aside>

    </footer>


    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", false)

</body>

</html>