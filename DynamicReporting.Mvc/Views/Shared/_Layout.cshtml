<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - DynamicReporting.Mvc</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>


<body class="min-h-screen flex flex-col bg-base-200 text-base-content">


    <header>

        <div class="navbar bg-base-100 shadow-md px-4 mb-6">

            <div class="flex-1">

                <!-- Brand -->
                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-ghost text-xl">

                    DynamicReporting.Mvc

                </a>

            </div>


            <div class="flex-none">

                <ul class="menu menu-horizontal px-1">

                    <li>
                        <a asp-area=""
                           asp-controller="Home"
                           asp-action="Index">

                            خانه

                        </a>
                    </li>

                    <li>
                        <a asp-area=""
                           asp-controller="ReportMetadata"
                           asp-action="Index">

                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                            </svg>

                            جداول

                        </a>
                    </li>

                    <li>
                        <details>
                            <summary>
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                گزارش‌ها
                            </summary>
                            <ul class="p-2 w-52 bg-base-100">
                                <li>
                                    <a asp-area=""
                                       asp-controller="ReportMetadata"
                                       asp-action="AllMetadata">
                                        متادیتای تمام جداول
                                    </a>
                                </li>
                            </ul>
                        </details>
                    </li>

                    <li>
                        <a asp-area=""
                           asp-controller="Home"
                           asp-action="Privacy">

                            حریم خصوصی

                        </a>
                    </li>

                </ul>

            </div>


        </div>


    </header>


    <main role="main"
          class="flex-1 container mx-auto px-4 pb-6">


        @RenderBody()


    </main>


    <footer class="footer footer-center bg-base-100 text-base-content p-4 border-t">


        <aside>

            <p>
                &copy; 1405 - DynamicReporting.Mvc -

                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Privacy"
                   class="link link-primary">

                    Privacy

                </a>

            </p>


        </aside>


    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>


    @await RenderSectionAsync("Scripts", false)


</body>

</html>