@model List<DisplayTableDto>

@{
    ViewData["Title"] = "جداول پایگاه داده";
}

<div class="container mx-auto px-4 py-8">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-4xl font-bold text-base-content mb-2">جداول پایگاه داده</h1>
        <p class="text-lg text-base-content/70">مشاهده و مدیریت جداول پایگاه داده</p>
    </div>

    <!-- Error Alert -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-error shadow-lg mb-6 animate-pulse">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l-2-2m0 0l-2-2m2 2l2-2m-2 2l-2 2m8-8l2 2m0 0l2 2m-2-2l-2 2m2-2l2-2"></path>
            </svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Action Buttons -->
    <div class="mb-6 flex flex-wrap gap-3">
        <a asp-action="AllMetadata" class="btn btn-primary gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            مشاهده متادیتای کامل
        </a>
    </div>

    <!-- Tables Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @if (Model != null && Model.Count > 0)
        {
            @foreach (var table in Model)
            {
                <div class="card bg-base-100 shadow-lg hover:shadow-2xl transition-shadow duration-300 border border-base-200">
                    <div class="card-body">
                        <!-- Table Icon -->
                        <div class="flex items-center mb-3">
                            <div class="w-12 h-12 rounded-lg bg-primary/20 flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                                </svg>
                            </div>
                        </div>

                        <!-- Physical Name -->
                        <h2 class="card-title text-xl text-base-content font-bold mb-1 break-words">
                            @table.PhysicalName
                        </h2>

                        <!-- Display Name -->
                        @if (!string.IsNullOrEmpty(table.DisplayName))
                        {
                            <p class="text-sm text-base-content/60 mb-4">@table.DisplayName</p>
                        }

                        <!-- Card Actions -->
                        <div class="card-actions justify-between items-center mt-4">
                            <span class="badge badge-lg badge-primary">جدول</span>
                            <a asp-action="Details" asp-route-tableName="@table.PhysicalName" 
                               class="btn btn-sm btn-outline btn-primary gap-1">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                </svg>
                                جزئیات
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-span-full">
                <div class="alert alert-info shadow-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span>هیچ جدولی یافت نشد.</span>
                </div>
            </div>
        }
    </div>

    <!-- Statistics Section (Optional) -->
    @if (Model != null && Model.Count > 0)
    {
        <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="stat bg-base-100 shadow">
                <div class="stat-figure text-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="inline-block w-8 h-8">
                        <path d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                </div>
                <div class="stat-title">تعداد جداول</div>
                <div class="stat-value">@Model.Count</div>
            </div>
        </div>
    }
</div>

<!-- 
Tailwind + DaisyUI Components Used:
- container: Main wrapper
- grid: Responsive grid layout (1 col mobile, 2 cols tablet, 3 cols desktop)
- card: Card component for each table
- badge: Table type badge
- btn: Button components
- alert: Error and info alerts
- stat: Statistics display
- svg icons from Heroicons
-->
