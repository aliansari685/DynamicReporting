@using DynamicReporting.Mvc.ViewModels
@model List<TableMetadataVm>

@{
    ViewData["Title"] = "متادیتای تمام جداول";
}

<div class="container mx-auto px-4 py-8">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-4xl font-bold text-base-content mb-2">متادیتای تمام جداول</h1>
        <p class="text-lg text-base-content/70">مشاهده ساختار و ستون‌های تمام جداول پایگاه داده</p>
    </div>

    <!-- Error Alert -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-error shadow-lg mb-6 animate-pulse">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l-2-2m0 0l-2-2m2 2l2-2m-2 2l-2 2m8-8l2 2m0 0l2 2m-2-2l-2 2m2-2l2-2"></path>
            </svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Action Buttons -->
    <div class="mb-6 flex flex-wrap gap-3">
        <a asp-action="Index" class="btn btn-outline gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            بازگشت به جداول
        </a>
    </div>

    @if (Model.Count > 0)
    {
        <!-- Accordion/Collapsible Tables -->
        <div class="space-y-4">
            @foreach (var table in Model)
            {
                <div class="collapse collapse-plus bg-base-100 shadow-lg border border-base-300">
                    <input type="checkbox" />
            
                    <div class="collapse-title flex items-center gap-3 text-xl font-semibold text-base-content cursor-pointer hover:bg-base-200/50 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2m-6 0V5a2 2 0 012-2h2a2 2 0 012 2v2m0 0h2V7m0 0a2 2 0 012 2v12a2 2 0 01-2 2h-2.5"></path>
                        </svg>
                        <span>@table.TableName</span>
                        <div class="badge badge-primary gap-1">
                            @table.Columns.Count
                        </div>
                    </div>

                    <div class="collapse-content">
                        @if (table.Columns.Count > 0)
                        {
                            <!-- Columns List -->
                            <div class="mt-4 space-y-2">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                    @foreach (var column in table.Columns)
                                    {
                                        <div class="card bg-base-200 shadow-sm hover:shadow-md transition-shadow">
                                            <div class="card-body p-4">
                                                <div class="flex items-start justify-between gap-2">
                                                    <div class="flex-1">
                                                        <h4 class="font-mono text-sm font-semibold text-primary break-words">
                                                            @column.PhysicalName
                                                        </h4>
                                                        @if (!string.IsNullOrEmpty(column.DisplayName))
                                                        {
                                                            <p class="text-sm text-base-content/70 mt-1">@column.DisplayName</p>
                                                        }
                                                        else
                                                        {
                                                            <p class="text-xs text-base-content/40 italic mt-1">بدون نام نمایشی</p>
                                                        }
                                                    </div>
                                                    <div class="badge badge-sm badge-success">فعال</div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- View Details Button -->
                            <div class="mt-4 pt-4 border-t border-base-300">
                                <a asp-action="Details" asp-route-tableName="@table.TableName" 
                                   class="btn btn-sm btn-primary gap-1">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                    </svg>
                                    مشاهده جزئیات
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info mt-4 text-sm">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-5 h-5">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <span>هیچ ستونی برای این جدول یافت نشد.</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Summary Statistics -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-12">
            <div class="stat bg-base-100 shadow">
                <div class="stat-figure text-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="inline-block w-8 h-8">
                        <path d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                </div>
                <div class="stat-title">تعداد جداول</div>
                <div class="stat-value text-primary">@Model.Count</div>
            </div>

            <div class="stat bg-base-100 shadow">
                <div class="stat-figure text-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="inline-block w-8 h-8">
                        <path d="M4 4a2 2 0 00-2 2v4a2 2 0 002 2V6h10a2 2 0 00-2-2H4zm2 6a2 2 0 012-2h8a2 2 0 012 2v4a2 2 0 01-2 2H8a2 2 0 01-2-2v-4zm6 4a2 2 0 100-4 2 2 0 000 4z"></path>
                    </svg>
                </div>
                <div class="stat-title">کل ستون‌ها</div>
                <div class="stat-value text-secondary">@Model.Sum(t => t.Columns.Count)</div>
            </div>

            <div class="stat bg-base-100 shadow">
                <div class="stat-figure text-accent">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="inline-block w-8 h-8">
                        <path fill-rule="evenodd" d="M4 4a2 2 0 00-2 2v4a2 2 0 002 2V6h10a2 2 0 00-2-2H4zm2 6a2 2 0 012-2h8a2 2 0 012 2v4a2 2 0 01-2 2H8a2 2 0 01-2-2v-4zm6 4a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                    </svg>
                </div>
                <div class="stat-title">ستون‌های نام‌گذاری شده</div>
                <div class="stat-value text-accent">@Model.Sum(t => t.Columns.Count(c => !string.IsNullOrEmpty(c.DisplayName)))</div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>هیچ جدولی یافت نشد.</span>
        </div>
    }
</div>

<!-- 
Tailwind + DaisyUI Components Used:
- collapse: Collapsible accordion for each table
- badge: Column count badges
- stat: Summary statistics at bottom
- card: Individual column cards
- btn: Action buttons
- alert: Error and info alerts
- grid: Responsive grid layout
- Responsive design with Persian support
-->
