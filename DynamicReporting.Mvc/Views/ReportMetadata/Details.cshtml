@using DynamicReporting.Mvc.ViewModels
@model TableMetadataVm

@{
    ViewData["Title"] = $"جزئیات جدول - {Model.TableName}";
}

<div class="container mx-auto px-4 py-8">
    <!-- Breadcrumb Navigation -->
    <div class="breadcrumbs text-sm mb-6 bg-base-100 rounded-lg p-4">
        <ul>
            <li>
                <a asp-controller="ReportMetadata" asp-action="Index" class="link link-hover">
                    جداول
                </a>
            </li>
            <li>@Model.TableName</li>
        </ul>
    </div>

    <!-- Error Alert -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-error shadow-lg mb-6 animate-pulse">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l-2-2m0 0l-2-2m2 2l2-2m-2 2l-2 2m8-8l2 2m0 0l2 2m-2-2l-2 2m2-2l2-2"></path>
            </svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Table Header Section -->
    <div class="card bg-base-100 shadow-lg mb-8 border border-primary/20">
        <div class="card-body">
            <div class="flex items-start justify-between gap-4">
                <div class="flex items-center gap-4">
                    <div class="w-16 h-16 rounded-lg bg-primary/20 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2m-6 0V5a2 2 0 012-2h2a2 2 0 012 2v2m0 0h2V7m0 0a2 2 0 012 2v12a2 2 0 01-2 2h-2.5"></path>
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-3xl font-bold text-base-content">@Model.TableName</h1>
                        <p class="text-base-content/60 mt-1">جدول پایگاه داده</p>
                    </div>
                </div>
                <a asp-action="Index" class="btn btn-ghost btn-circle" title="بازگشت">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </a>
            </div>
        </div>
    </div>

    <!-- Columns Information -->
    <div class="mb-8">
        <div class="flex items-center gap-3 mb-4">
            <h2 class="text-2xl font-bold text-base-content">ستون‌ها</h2>
            @if (Model.Columns.Count > 0)
            {
                <div class="badge badge-lg badge-primary">@Model.Columns.Count</div>
            }
        </div>

        @if (Model.Columns is { Count: > 0 })
        {
            <!-- Table View for Columns -->
            <div class="overflow-x-auto">
                <table class="table table-zebra w-full bg-base-100 shadow-lg rounded-lg">
                    <thead class="text-base-content/70 bg-base-200">
                        <tr>
                            <th class="w-1/3">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 inline mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                                </svg>
                                نام فیزیکی
                            </th>
                            <th class="w-1/3">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 inline mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                                </svg>
                                نام نمایشی
                            </th>
                            <th class="w-1/3 text-center">وضعیت</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var column in Model.Columns)
                        {
                            <tr class="hover:bg-base-200/50 transition-colors">
                                <td>
                                    <div class="font-mono text-sm font-semibold text-primary">
                                        @column.PhysicalName
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(column.DisplayName))
                                    {
                                        <span class="font-medium text-base-content">@column.DisplayName</span>
                                    }
                                    else
                                    {
                                        <span class="text-base-content/40 italic">-</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="badge badge-sm badge-success gap-1">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                        </svg>
                                        فعال
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Cards View for Mobile (Alternative) -->
            <div class="grid grid-cols-1 md:hidden gap-4 mt-6">
                @foreach (var column in Model.Columns)
                {
                    <div class="card bg-base-100 shadow-md border border-base-300">
                        <div class="card-body p-4">
                            <h3 class="font-mono text-sm font-semibold text-primary">@column.PhysicalName</h3>
                            @if (!string.IsNullOrEmpty(column.DisplayName))
                            {
                                <p class="text-sm text-base-content mt-2">@column.DisplayName</p>
                            }
                            <div class="mt-3">
                                <badge class="badge badge-sm badge-success">فعال</badge>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info shadow-lg">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>هیچ ستونی برای این جدول یافت نشد.</span>
            </div>
        }
    </div>

    <!-- Information Panel -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Column Statistics -->
        <div class="card bg-base-100 shadow-lg">
            <div class="card-body">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-base-content/60 text-sm">تعداد ستون‌ها</p>
                        <p class="text-4xl font-bold text-primary">@Model.Columns.Count ?? 0</p>
                    </div>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-primary opacity-20" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M4 4a2 2 0 00-2 2v4a2 2 0 002 2V6h10a2 2 0 00-2-2H4zm2 6a2 2 0 012-2h8a2 2 0 012 2v4a2 2 0 01-2 2H8a2 2 0 01-2-2v-4zm6 4a2 2 0 100-4 2 2 0 000 4z"></path>
                    </svg>
                </div>
            </div>
        </div>

        <!-- Columns with Display Names -->
        <div class="card bg-base-100 shadow-lg">
            <div class="card-body">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-base-content/60 text-sm">ستون‌های با نام نمایشی</p>
                        <p class="text-4xl font-bold text-accent">
                            @(Model.Columns.Count(c => !string.IsNullOrEmpty(c.DisplayName)))
                        </p>
                    </div>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-accent opacity-20" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4 4a2 2 0 00-2 2v4a2 2 0 002 2V6h10a2 2 0 00-2-2H4zm2 6a2 2 0 012-2h8a2 2 0 012 2v4a2 2 0 01-2 2H8a2 2 0 01-2-2v-4zm6 4a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-wrap gap-3 mt-8">
        <a asp-action="Index" class="btn btn-outline">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            بازگشت به جداول
        </a>
        <a asp-action="AllMetadata" class="btn btn-outline btn-info">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            نمایش تمام متادیتا
        </a>
    </div>
</div>