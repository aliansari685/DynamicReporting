<dialog id="confirmModal"
        class="modal">

    <div class="modal-box">

        <h3 id="confirmModalTitle"
            class="text-lg font-bold">
            تأیید عملیات
        </h3>

        <p id="confirmModalMessage"
           class="py-4 text-base-content/70">
        </p>

        <div class="modal-action">

            <button id="confirmModalCancel"
                    type="button"
                    class="btn btn-ghost">
                لغو
            </button>

            <button id="confirmModalConfirm"
                    type="button"
                    class="btn btn-error">
                تأیید
            </button>

        </div>

    </div>

    <form method="dialog"
          class="modal-backdrop">

        <button>close</button>

    </form>

</dialog>