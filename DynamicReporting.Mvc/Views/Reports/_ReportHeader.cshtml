@using DynamicReporting.Mvc.ViewModels
@model ReportsIndexVm


    <!-- Header -->
    <div class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">

        <div>
            <h1 class="text-3xl font-black md:text-4xl">
                مدیریت گزارش‌ها
            </h1>

            <p class="mt-2 text-base-content/60">
                گزارش‌ها را مشاهده، ویرایش، حذف و مدیریت کنید.
            </p>
        </div>

        <div class="flex flex-wrap gap-2">

            <button type="button"
                    class="btn btn-primary"
                    onclick="openCreateModal()">

                <svg xmlns="http://www.w3.org/2000/svg"
                     class="h-5 w-5"
                     fill="none"
                     viewBox="0 0 24 24"
                     stroke="currentColor">

                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M12 4v16m8-8H4" />

                </svg>

                گزارش جدید

            </button>

            <button type="button"
                    class="btn btn-outline"
                    onclick="openGeneratedReports()">

                گزارش‌های تولید شده

            </button>

        </div>

    </div>


