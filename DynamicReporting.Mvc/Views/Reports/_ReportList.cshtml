@using DynamicReporting.Mvc.ViewModels
@model ReportsIndexVm

@{
    var tableDisplayNames =
        ViewBag.TableDisplayNames as IReadOnlyDictionary<string, string>
        ?? new Dictionary<string, string>();
}

<!-- Reports list -->
<aside class="card h-fit bg-base-100 shadow-sm">

    <div class="card-body p-3">

        <div class="mb-3 flex items-center justify-between">

            <h2 class="font-bold">
                گزارش‌ها
            </h2>

        </div>


        <div class="space-y-2">

            @foreach (var report in Model.Reports)
            {
                var selected =
                Model.SelectedReport?.Id == report.Id;

                <div class="group rounded-xl border
                    @(selected
                                                                          ? "border-primary bg-primary/10"
                                                                          : "border-base-300 bg-base-100")">

                    <a asp-controller="Reports"
                       asp-action="Index"
                       asp-route-reportId="@report.Id"
                       class="block px-3 py-2.5">

                        <div class="flex items-start justify-between gap-2">

                            <div class="min-w-0">

                                <div class="truncate font-semibold">
                                    @report.Name
                                </div>

                                <div class="mt-1 truncate text-xs text-base-content/50">
                                    @tableDisplayNames.GetValueOrDefault(
                                    report.BaseTable,
                                                                        report.BaseTable)
                                </div>

                            </div>

                            @if (report.IsDefault)
                            {
                                <span class="badge badge-primary badge-sm shrink-0">
                                    پیش‌فرض
                                </span>
                            }

                        </div>

                    </a>

                </div>
            }

            @if (!Model.Reports.Any())
            {
                <div class="rounded-xl border border-dashed p-5 text-center">

                    <p class="text-sm text-base-content/50">
                        هنوز گزارشی ایجاد نشده است.
                    </p>

                    <button type="button"
                            onclick="openCreateModal()"
                            class="btn btn-primary btn-sm mt-4">

                        ایجاد اولین گزارش

                    </button>

                </div>
            }

        </div>

    </div>

</aside>

