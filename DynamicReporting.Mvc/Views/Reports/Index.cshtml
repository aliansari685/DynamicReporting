@using DynamicReporting.Mvc.ViewModels
@model DynamicReporting.Mvc.ViewModels.ReportsIndexVm

@{
    ViewData["Title"] = "گزارش‌ها";

    var metadata =
        (ViewBag.Metadata as IReadOnlyList<TableMetadataVm>)
        ?? [];
}

<div class="container mx-auto px-4 py-8 lg:px-8">

    <!-- Header -->
    <div class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">

        <div>
            <div class="badge badge-primary badge-outline mb-3">
                Dynamic Reporting
            </div>

            <h1 class="text-3xl font-black md:text-4xl">
                مدیریت گزارش‌ها
            </h1>

            <p class="mt-2 text-base-content/60">
                گزارش‌ها را مشاهده، ویرایش، حذف و مدیریت کنید.
            </p>
        </div>

        <div class="flex flex-wrap gap-2">

            <button type="button"
                    class="btn btn-primary"
                    onclick="openCreateModal()">

                <svg xmlns="http://www.w3.org/2000/svg"
                     class="h-5 w-5"
                     fill="none"
                     viewBox="0 0 24 24"
                     stroke="currentColor">

                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M12 4v16m8-8H4" />

                </svg>

                گزارش جدید

            </button>

            <button type="button"
                    class="btn btn-outline"
                    onclick="openGeneratedReports()">

                گزارش‌های تولید شده

            </button>

        </div>

    </div>


    <!-- Stats -->
    <div class="mb-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">

        <div class="stat rounded-2xl bg-base-100 shadow-sm">

            <div class="stat-figure text-primary">

                <svg xmlns="http://www.w3.org/2000/svg"
                     class="h-8 w-8"
                     fill="none"
                     viewBox="0 0 24 24"
                     stroke="currentColor">

                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M3 7h18M3 12h18M3 17h18" />

                </svg>

            </div>

            <div class="stat-title">
                تعداد گزارش‌ها
            </div>

            <div class="stat-value text-primary">
                @Model.Reports.Count
            </div>

        </div>


        <div class="stat rounded-2xl bg-base-100 shadow-sm">

            <div class="stat-title">
                گزارش پیش‌فرض
            </div>

            <div class="stat-value text-lg">

                @(Model.DefaultReport?.Name ?? "تنظیم نشده")

            </div>

            <div class="stat-desc">
                گزارش اولیه سیستم
            </div>

        </div>


        <div class="stat rounded-2xl bg-base-100 shadow-sm">

            <div class="stat-title">
                وضعیت اتصال
            </div>

            <div class="stat-value text-lg text-success">
                آنلاین
            </div>

            <div class="stat-desc">
                Real-Time فعال
            </div>

        </div>

    </div>


    <!-- Main -->
    <div class="grid gap-6 xl:grid-cols-[320px_1fr]">


        <!-- Reports list -->
        <aside class="card bg-base-100 shadow-sm">

            <div class="card-body p-4">

                <div class="mb-4 flex items-center justify-between">

                    <h2 class="font-bold">
                        گزارش‌ها
                    </h2>

                    <span class="badge badge-primary badge-outline">
                        @Model.Reports.Count
                    </span>

                </div>


                <div class="space-y-2">

                    @foreach (var report in Model.Reports)
                    {
                        var selected =
                        Model.SelectedReport?.Id == report.Id;

                        <div class="group rounded-xl border
                                                                            @(selected
                                                                                                                                                                                                                                                                                                                                          ? "border-primary bg-primary/10"
                                                                                                                                                                                                                                                                                                                                          : "border-base-300 bg-base-100")">

                            <a asp-controller="Reports"
                               asp-action="Index"
                               asp-route-reportId="@report.Id"
                               class="block p-4">

                                <div class="flex items-start justify-between gap-3">

                                    <div class="min-w-0">

                                        <div class="truncate font-semibold">
                                            @report.Name
                                        </div>

                                        <div class="mt-1 text-xs text-base-content/50">
                                            @report.BaseTable
                                        </div>

                                    </div>

                                    @if (report.IsDefault)
                                    {
                                        <span class="badge badge-primary badge-sm">
                                            پیش‌فرض
                                        </span>
                                    }

                                </div>

                            </a>

                        </div>
                    }

                    @if (!Model.Reports.Any())
                    {
                        <div class="rounded-xl border border-dashed p-6 text-center">

                            <p class="text-sm text-base-content/50">
                                هنوز گزارشی ایجاد نشده است.
                            </p>

                            <button type="button"
                                    onclick="openCreateModal()"
                                    class="btn btn-primary btn-sm mt-4">

                                ایجاد اولین گزارش

                            </button>

                        </div>
                    }

                </div>

            </div>

        </aside>


        <!-- Report -->
        <section class="card min-w-0 bg-base-100 shadow-sm">

            @if (Model.SelectedReport is not null)
            {
                <div class="card-body">

                    <!-- Report header -->
                    <div class="flex flex-col gap-4 border-b border-base-300 pb-5 lg:flex-row lg:items-center lg:justify-between">

                        <div>

                            <div class="flex flex-wrap items-center gap-2">

                                <h2 class="text-2xl font-bold">
                                    @Model.SelectedReport.Name
                                </h2>

                                @if (Model.SelectedReport.IsDefault)
                                {
                                    <span class="badge badge-primary">
                                        پیش‌فرض
                                    </span>
                                }

                            </div>

                            <p class="mt-2 text-sm text-base-content/50">

                                جدول پایه:
                                <span class="font-semibold">
                                    @Model.SelectedReport.BaseTable
                                </span>

                                <span class="mx-2">
                                    •
                                </span>

                                @Model.SelectedReport.SelectedColumns.Count
                                ستون

                            </p>

                        </div>


                        <div class="flex flex-wrap gap-2">

                            <button class="btn btn-sm btn-outline"
                                    onclick="openEditModal(@Model.SelectedReport.Id)">

                                ویرایش

                            </button>

                            <button class="btn btn-sm btn-error btn-outline"
                                    onclick="deleteReport(@Model.SelectedReport.Id)">

                                حذف

                            </button>

                            <button class="btn btn-sm btn-secondary"
                                    onclick="exportReport(@Model.SelectedReport.Id)">

                                Excel

                            </button>

                        </div>

                    </div>


                    <!-- Filters -->
                    <div class="mt-5 rounded-2xl bg-base-200 p-4">

                        <div class="mb-4 flex items-center justify-between">

                            <h3 class="font-bold">
                                فیلتر و مرتب‌سازی
                            </h3>

                            <span id="reportStatus"
                                  class="badge badge-ghost">

                                آماده

                            </span>

                        </div>

                        <div class="grid gap-3 md:grid-cols-3">

                            <select id="filterColumn"
                                    class="select select-bordered w-full">

                                <option value="">
                                    ستون فیلتر
                                </option>

                            </select>


                            <input id="filterValue"
                                   class="input input-bordered w-full"
                                   placeholder="مقدار..." />


                            <button type="button"
                                    onclick="loadReportData(1)"
                                    class="btn btn-primary">

                                اعمال فیلتر

                            </button>

                        </div>

                    </div>


                    <!-- Grid -->
                    <div class="mt-6">

                        <div class="overflow-x-auto rounded-xl border border-base-300">

                            <table class="table table-zebra">

                                <thead id="reportTableHead">
                                </thead>

                                <tbody id="reportTableBody">

                                    <tr>
                                        <td class="py-12 text-center">
                                            <span class="loading loading-spinner loading-lg"></span>
                                        </td>
                                    </tr>

                                </tbody>

                            </table>

                        </div>


                        <!-- Pagination -->
                        <div class="mt-4 flex items-center justify-between">

                            <button id="previousPage"
                                    class="btn btn-sm btn-outline"
                                    onclick="changePage(-1)">

                                قبلی

                            </button>

                            <span id="pageInfo"
                                  class="text-sm text-base-content/60">

                                صفحه 1

                            </span>

                            <button id="nextPage"
                                    class="btn btn-sm btn-outline"
                                    onclick="changePage(1)">

                                بعدی

                            </button>

                        </div>

                    </div>

                </div>
            }
            else
            {
                <div class="card-body flex min-h-[500px] items-center justify-center text-center">

                    <div>

                        <div class="mx-auto mb-5 flex h-20 w-20 items-center justify-center rounded-full bg-primary/10 text-primary">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 class="h-10 w-10"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor">

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h10a2 2 0 012 2v12a2 2 0 01-2 2z" />

                            </svg>

                        </div>

                        <h2 class="text-2xl font-bold">
                            گزارشی انتخاب نشده است
                        </h2>

                        <p class="mt-2 text-base-content/60">
                            از لیست سمت راست یک گزارش انتخاب کنید.
                        </p>

                    </div>

                </div>
            }

        </section>

    </div>

</div>


<!-- ========================================================= -->
<!-- Create / Edit Modal -->
<!-- ========================================================= -->

<dialog id="reportEditorModal" class="modal">

    <div class="modal-box max-w-5xl">

        <form method="dialog">

            <button class="btn btn-sm btn-circle btn-ghost absolute right-3 top-3">
                ✕
            </button>

        </form>

        <h3 id="editorTitle"
            class="text-2xl font-bold">

            ایجاد گزارش

        </h3>

        <p class="mt-1 text-sm text-base-content/50">
            جدول پایه و ستون‌های مورد نیاز گزارش را انتخاب کنید.
        </p>


        <form id="reportEditorForm"
              class="mt-6 space-y-6">

            <input type="hidden"
                   id="editingReportId"
                   value="" />


            <!-- Name -->
            <div>

                <label class="label">
                    <span class="label-text font-semibold">
                        نام گزارش
                    </span>
                </label>

                <input id="reportName"
                       class="input input-bordered w-full"
                       placeholder="مثلاً گزارش جامع مشتریان"
                       required />

            </div>


            <!-- Base table -->
            <div>

                <label class="label">
                    <span class="label-text font-semibold">
                        جدول پایه
                    </span>
                </label>

                <select id="baseTable"
                        class="select select-bordered w-full"
                        required>

                    <option value="">
                        انتخاب جدول پایه
                    </option>

                    @foreach (var table in metadata)
                    {
                        <option value="@table.TableName">
                            @table.TableName
                        </option>
                    }

                </select>

            </div>


            <!-- Columns -->
            <div>

                <div class="mb-3 flex items-center justify-between">

                    <div>

                        <h4 class="font-bold">
                            ستون‌های گزارش
                        </h4>

                        <p class="text-xs text-base-content/50">
                            ستون‌های مورد نظر را انتخاب کنید.
                        </p>

                    </div>

                    <span id="selectedColumnCount"
                          class="badge badge-primary">
                        0
                    </span>

                </div>


                <div id="columnsContainer"
                     class="grid max-h-80 gap-2 overflow-y-auto rounded-xl border border-base-300 p-4 md:grid-cols-2">

                    <div class="text-center text-sm text-base-content/50 md:col-span-2">
                        ابتدا جدول پایه را انتخاب کنید.
                    </div>

                </div>

            </div>


            <!-- Default -->
            <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-base-300 p-4">

                <input id="isDefault"
                       type="checkbox"
                       class="checkbox checkbox-primary" />

                <div>

                    <div class="font-semibold">
                        گزارش پیش‌فرض
                    </div>

                    <div class="text-xs text-base-content/50">
                        این گزارش به عنوان گزارش پیش‌فرض سیستم انتخاب شود.
                    </div>

                </div>

            </label>


            <!-- Actions -->
            <div class="modal-action">

                <button type="button"
                        class="btn btn-ghost"
                        onclick="reportEditorModal.close()">

                    انصراف

                </button>

                <button type="submit"
                        class="btn btn-primary">

                    ذخیره گزارش

                </button>

            </div>

        </form>

    </div>

</dialog>


<!-- ========================================================= -->
<!-- Generated Reports Modal -->
<!-- ========================================================= -->

<dialog id="generatedReportsModal"
        class="modal">

    <div class="modal-box max-w-5xl">

        <form method="dialog">

            <button class="btn btn-sm btn-circle btn-ghost absolute right-3 top-3">
                ✕

            </button>

        </form>

        <h3 class="text-2xl font-bold">
            گزارش‌های تولید شده
        </h3>

        <p class="mt-1 text-sm text-base-content/50">
            وضعیت Exportهای قبلی را مشاهده و فایل آماده را دانلود کنید.
        </p>


        <div id="generatedReportsContainer"
             class="mt-6 space-y-3">

            <div class="py-10 text-center">
                <span class="loading loading-spinner loading-lg"></span>
            </div>

        </div>

    </div>

</dialog>


<!-- ========================================================= -->
<!-- SignalR Notification -->
<!-- ========================================================= -->

<div id="notificationContainer"
     class="toast toast-top toast-start z-[9999]">
</div>


@section Scripts {

    <!-- SignalR -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

    <script>

        let currentPage = 1;
        let totalPages = 1;

        const selectedReportId =
            @(Model.SelectedReport?.Id ?? 0);


        const Metadata =
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(metadata));


        /*
         * =====================================================
         * Report Data
         * =====================================================
         */

        async function loadReportData(page = 1) {

            if (!selectedReportId)
                return;

            currentPage = page;

            const response = await fetch(
                '@Url.Action("Data", "ReportData")'
                + '?reportDefinitionId='
                + selectedReportId
                + '&page='
                + page
                + '&take=10'
            );

            if (!response.ok) {

                showNotification(
                    'خطا در دریافت اطلاعات گزارش.',
                    'error');

                return;
            }

            const result = await response.json();

            renderReportTable(result);

        }


        function renderReportTable(result) {

            const head =
                document.getElementById('reportTableHead');

            const body =
                document.getElementById('reportTableBody');

            head.innerHTML = '';
            body.innerHTML = '';

            if (!result.data || result.data.length === 0) {

                body.innerHTML = `
                    <tr>
                        <td class="py-10 text-center">
                            داده‌ای برای نمایش وجود ندارد.
                        </td>
                    </tr>`;

                return;
            }


            const columns =
                Object.keys(result.data[0]);

            head.innerHTML = `
                <tr>
                    ${columns.map(x =>
                        `<th>${escapeHtml(x)}</th>`
                    ).join('')}
                </tr>`;


            result.data.forEach(row => {

                const tr =
                    document.createElement('tr');

                columns.forEach(column => {

                    const td =
                        document.createElement('td');

                    td.textContent =
                        row[column] ?? '';

                    tr.appendChild(td);

                });

                body.appendChild(tr);

            });


            totalPages =
                result.totalPages || 1;

            document.getElementById('pageInfo').textContent =
                `صفحه ${result.page} از ${totalPages}`;

            document.getElementById('previousPage').disabled =
                result.page <= 1;

            document.getElementById('nextPage').disabled =
                result.page >= totalPages;

        }


        function changePage(delta) {

            const next =
                currentPage + delta;

            if (next < 1 || next > totalPages)
                return;

            loadReportData(next);

        }


        /*
         * =====================================================
         * Filterable Columns
         * =====================================================
         */

        async function loadFilterableColumns() {

            if (!selectedReportId)
                return;

            const response = await fetch(
                '@Url.Action("FilterableColumns", "ReportData")'
                + '?reportDefinitionId='
                + selectedReportId
            );

            if (!response.ok)
                return;

            const columns =
                await response.json();

            const select =
                document.getElementById('filterColumn');

            if (!select)
                return;

            select.innerHTML =
                '<option value="">ستون فیلتر</option>';

            columns.forEach(column => {

                const option =
                    document.createElement('option');

                option.value =
                    column.field;

                option.textContent =
                    column.displayName || column.field;

                select.appendChild(option);

            });

        }


        /*
         * =====================================================
         * Create
         * =====================================================
         */

        function openCreateModal() {

            document.getElementById('editorTitle').textContent =
                'ایجاد گزارش';

            document.getElementById('editingReportId').value =
                '';

            document.getElementById('reportName').value =
                '';

            document.getElementById('baseTable').value =
                '';

            document.getElementById('isDefault').checked =
                false;

            renderColumns();

            document
                .getElementById('reportEditorModal')
                .showModal();

        }


        /*
         * =====================================================
         * Edit
         * =====================================================
         */

        async function openEditModal(id) {

            const response =
                await fetch(
                    '@Url.Action("Get", "Reports")'
                    + '?id='
                    + id);

            if (!response.ok) {

                showNotification(
                    'دریافت اطلاعات گزارش انجام نشد.',
                    'error');

                return;
            }

            const report =
                await response.json();

            document.getElementById('editorTitle').textContent =
                'ویرایش گزارش';

            document.getElementById('editingReportId').value =
                report.id;

            document.getElementById('reportName').value =
                report.name;

            document.getElementById('baseTable').value =
                report.baseTable;

            document.getElementById('isDefault').checked =
                report.isDefault;

            renderColumns(
                report.selectedColumns || []);

            document
                .getElementById('reportEditorModal')
                .showModal();

        }


        /*
         * =====================================================
         * Columns
         * =====================================================
         */

        document
            .getElementById('baseTable')
            .addEventListener(
                'change',
                () => renderColumns()
            );


        function renderColumns(selected = []) {

            const table =
                document.getElementById('baseTable').value;

            const container =
                document.getElementById('columnsContainer');

            container.innerHTML = '';

            if (!table) {

                container.innerHTML = `
                    <div class="py-6 text-center text-sm text-base-content/50 md:col-span-2">
                        ابتدا جدول پایه را انتخاب کنید.
                    </div>`;

                updateSelectedCount();

                return;
            }


            const MetadataTable =
                Metadata.find(x =>
                    x.tableName === table);


            if (!MetadataTable) {

                container.innerHTML = `
                    <div class="py-6 text-center text-sm text-error md:col-span-2">
                        متادیتای این جدول پیدا نشد.
                    </div>`;

                return;
            }


            MetadataTable.columns.forEach(column => {

                const checked =
                    selected.some(x =>
                        x.table === table &&
                        x.column === column.physicalName);


                const wrapper =
                    document.createElement('label');

                wrapper.className =
                    'flex cursor-pointer items-center gap-3 rounded-lg border border-base-300 p-3 hover:bg-base-200';


                wrapper.innerHTML = `
                    <input
                        type="checkbox"
                        class="checkbox checkbox-primary report-column"
                        data-table="${escapeHtml(table)}"
                        data-column="${escapeHtml(column.physicalName)}"
                        ${checked ? 'checked' : ''} />

                    <span class="flex flex-col">

                        <span class="font-medium">
                            ${escapeHtml(column.displayName || column.physicalName)}
                        </span>

                        <span class="text-xs text-base-content/50">
                            ${escapeHtml(column.physicalName)}
                        </span>

                    </span>
                `;


                container.appendChild(wrapper);

            });


            document
                .querySelectorAll('.report-column')
                .forEach(x =>
                    x.addEventListener(
                        'change',
                        updateSelectedCount));

            updateSelectedCount();

        }


        function updateSelectedCount() {

            const count =
                document.querySelectorAll(
                    '.report-column:checked').length;

            const element =
                document.getElementById(
                    'selectedColumnCount');

            if (element)
                element.textContent = count;

        }


        /*
         * =====================================================
         * Save
         * =====================================================
         */

        document
            .getElementById('reportEditorForm')
            .addEventListener(
                'submit',
                async function (event) {

                    event.preventDefault();

                    const id =
                        document.getElementById(
                            'editingReportId').value;


                    const selectedColumns =
                        Array.from(
                            document.querySelectorAll(
                                '.report-column:checked'))
                            .map(x => ({
                                table: x.dataset.table,
                                column: x.dataset.column
                            }));


                    const model = {

                        name:
                            document.getElementById(
                                'reportName').value,

                        baseTable:
                            document.getElementById(
                                'baseTable').value,

                        isDefault:
                            document.getElementById(
                                'isDefault').checked,

                        createdBy: 'MVC',

                        selectedColumns:
                            selectedColumns

                    };


                    const token =
                        document.querySelector(
                            'input[name="__RequestVerificationToken"]')
                            ?.value;


                    const isEdit =
                        id !== '';


                    const url =
                        isEdit
                            ? '@Url.Action("Update", "Reports")'
                                + '?id=' + id
                            : '@Url.Action("Create", "Reports")';


                    const response =
                        await fetch(
                            url,
                            {
                                method:
                                    isEdit
                                        ? 'PUT'
                                        : 'POST',

                                headers: {

                                    'Content-Type':
                                        'application/json',

                                    ...(token
                                        ? {
                                            'RequestVerificationToken':
                                                token
                                        }
                                        : {})

                                },

                                body:
                                    JSON.stringify(model)

                            });


                    if (!response.ok) {

                        showNotification(
                            'ذخیره گزارش انجام نشد.',
                            'error');

                        return;

                    }


                    showNotification(
                        isEdit
                            ? 'گزارش با موفقیت ویرایش شد.'
                            : 'گزارش با موفقیت ایجاد شد.',
                        'success');


                    document
                        .getElementById('reportEditorModal')
                        .close();


                    setTimeout(
                        () => location.reload(),
                        600);

                });


        /*
         * =====================================================
         * Delete
         * =====================================================
         */

        async function deleteReport(id) {

            if (!confirm(
                'آیا از حذف این گزارش مطمئن هستید؟'))
                return;


            const response =
                await fetch(
                    '@Url.Action("Delete", "Reports")'
                    + '?id='
                    + id,
                    {
                        method: 'DELETE'
                    });


            if (!response.ok) {

                showNotification(
                    'حذف گزارش انجام نشد.',
                    'error');

                return;
            }


            showNotification(
                'گزارش با موفقیت حذف شد.',
                'success');


            setTimeout(
                () => location.href =
                    '@Url.Action("Index", "Reports")',
                500);

        }


        /*
         * =====================================================
         * Export
         * =====================================================
         */

        async function exportReport(id) {

            const response =
                await fetch(
                    '@Url.Action("Export", "ReportExport")'
                    + '?reportDefinitionId='
                    + id
                    + '&type=excel'
                );


            if (!response.ok) {

                showNotification(
                    'شروع عملیات Export ناموفق بود.',
                    'error');

                return;

            }


            const result =
                await response.json();


            showNotification(
                result.message ||
                'Export شروع شد. پس از آماده شدن اطلاع داده می‌شود.',
                'info');


            if (result.reportId)
                await joinReportGroup(
                    result.reportId);

        }


        /*
         * =====================================================
         * Generated Reports
         * =====================================================
         */

        async function openGeneratedReports() {

            document
                .getElementById('generatedReportsModal')
                .showModal();


            const container =
                document.getElementById(
                    'generatedReportsContainer');


            container.innerHTML = `
                <div class="py-10 text-center">
                    <span class="loading loading-spinner loading-lg"></span>
                </div>`;


            const response =
                await fetch(
                    '@Url.Action("GeneratedReports", "ReportGenerated")');


            if (!response.ok) {

                container.innerHTML = `
                    <div class="alert alert-error">
                        دریافت گزارش‌های تولید شده ناموفق بود.
                    </div>`;

                return;
            }


            const reports =
                await response.json();


            if (!reports.length) {

                container.innerHTML = `
                    <div class="py-10 text-center text-base-content/50">
                        گزارشی تولید نشده است.
                    </div>`;

                return;

            }


            container.innerHTML = '';


            reports.forEach(report => {

                const item =
                    document.createElement('div');

                item.className =
                    'flex flex-col gap-3 rounded-xl border border-base-300 p-4 md:flex-row md:items-center md:justify-between';


                item.innerHTML = `

                    <div>

                        <div class="font-semibold">
                            ${escapeHtml(report.status || 'نامشخص')}
                        </div>

                        <div class="mt-1 text-xs text-base-content/50">
                            ${escapeHtml(report.fileType || '')}
                        </div>

                    </div>


                    <div class="flex gap-2">

                        <a
                            href="@Url.Action("DownloadGeneratedReport", "ReportGenerated")?id=${report.reportGuid}"
                            class="btn btn-sm btn-primary">

                            دانلود

                        </a>

                        <button
                            class="btn btn-sm btn-error btn-outline"
                            onclick="deleteGeneratedReport('${report.reportGuid}')">

                            حذف

                        </button>

                    </div>

                `;


                container.appendChild(item);

            });

        }


        async function deleteGeneratedReport(id) {

            if (!confirm(
                'آیا از حذف این گزارش مطمئن هستید؟'))
                return;


            const response =
                await fetch(
                    '@Url.Action("DeleteGeneratedReport", "ReportGenerated")'
                    + '?id=' + id,
                    {
                        method: 'DELETE'
                    });


            if (response.ok) {

                showNotification(
                    'گزارش حذف شد.',
                    'success');

                openGeneratedReports();

            }

        }


        /*
         * =====================================================
         * SignalR
         * =====================================================
         */

        const connection =
            new signalR.HubConnectionBuilder()
                .withUrl('/report-hub')
                .withAutomaticReconnect()
                .build();


        async function startSignalR() {

            try {

                await connection.start();

                console.log(
                    'SignalR connected.');

            }
            catch (error) {

                console.error(
                    'SignalR connection failed.',
                    error);

                setTimeout(
                    startSignalR,
                    5000);

            }

        }


        connection.on(
            'ReportReady',
            function (data) {

                showNotification(
                    data.message ||
                    'گزارش شما آماده دانلود است.',
                    'success');


                openGeneratedReports();

            });


        async function joinReportGroup(reportGuid) {

            try {

                await connection.invoke(
                    'JoinGroup',
                    reportGuid.toString());

            }
            catch (error) {

                console.error(
                    'Could not join report group.',
                    error);

            }

        }


        /*
         * =====================================================
         * Notification
         * =====================================================
         */

        function showNotification(
            message,
            type = 'info') {

            const container =
                document.getElementById(
                    'notificationContainer');


            const alert =
                document.createElement('div');


            alert.className =
                `alert alert-${type} shadow-lg`;


            alert.innerHTML = `
                <span>
                    ${escapeHtml(message)}
                </span>`;


            container.appendChild(alert);


            setTimeout(
                () => alert.remove(),
                5000);

        }


        /*
         * =====================================================
         * Helpers
         * =====================================================
         */

        function escapeHtml(value) {

            if (value === null ||
                value === undefined)
                return '';

            return String(value)
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');

        }


        /*
         * =====================================================
         * Initial Load
         * =====================================================
         */

        document.addEventListener(
            'DOMContentLoaded',
            async function () {

                if (selectedReportId) {

                    await loadReportData(1);

                    await loadFilterableColumns();

                }

                await startSignalR();

            });

    </script>
}