<dialog id="reportFilterPanel"
        class="fixed inset-0 z-[9999] m-0 h-full w-full max-h-none max-w-none bg-black/50 p-0">

    <div class="relative mx-auto flex h-full w-full max-w-2xl flex-col bg-base-100 shadow-2xl">

        <!-- Header -->
        <div class="flex shrink-0 items-center justify-between border-b border-base-300 px-5 py-4">

            <div>
                <div class="flex items-center gap-2">
                    <h3 class="text-xl font-bold">
                        فیلتر و مرتب‌سازی
                    </h3>

                    <span id="panelFilterCount"
                          class="badge badge-primary badge-sm">
                        0
                    </span>
                </div>

                <p class="mt-1 text-xs text-base-content/50">
                    شرایط مورد نظر را تنظیم کنید و سپس روی «اعمال» بزنید.
                </p>
            </div>

            <form method="dialog">
                <button type="submit"
                        class="btn btn-sm btn-circle btn-ghost"
                        aria-label="بستن">
                    ✕
                </button>
            </form>

        </div>

        <!-- Content -->
        <div class="flex-1 overflow-y-auto p-5">

            <!-- Active filters -->
            <section>

                <div class="mb-3 flex items-center justify-between">

                    <div>
                        <h4 class="font-bold">
                            فیلترهای فعال
                        </h4>

                        <p class="mt-1 text-xs text-base-content/50">
                            می‌توانید چند شرط را همزمان اعمال کنید.
                        </p>
                    </div>

                    <button type="button"
                            id="clearAllFilters"
                            class="btn btn-xs btn-ghost text-error">
                        پاک کردن همه
                    </button>

                </div>

                <div id="filterRulesContainer"
                     class="space-y-2">
                </div>

            </section>

            <div class="divider my-5"></div>

            <!-- Add filter -->
            <section>

                <div class="mb-3 flex items-center justify-between">

                    <div>
                        <h4 class="font-bold">
                            افزودن فیلتر
                        </h4>

                        <p class="mt-1 text-xs text-base-content/50">
                            ابتدا ستون، سپس عملگر و مقدار را انتخاب کنید.
                        </p>
                    </div>

                    <span class="badge badge-ghost badge-sm">
                        شرط جدید
                    </span>

                </div>

                <div class="rounded-2xl border border-base-300 bg-base-200/50 p-4">

                    <div class="space-y-3">

                        <div>
                            <label class="label py-1">
                                <span class="label-text text-xs font-semibold">
                                    ستون
                                </span>
                            </label>

                            <select id="filterColumn"
                                    class="select select-bordered w-full">
                                <option value="">
                                    انتخاب ستون
                                </option>
                            </select>
                        </div>

                        <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)]">

                            <div>
                                <label class="label py-1">
                                    <span class="label-text text-xs font-semibold">
                                        عملگر
                                    </span>
                                </label>

                                <select id="filterOperator"
                                        class="select select-bordered w-full"
                                        disabled>
                                    <option value="">
                                        ابتدا ستون را انتخاب کنید
                                    </option>
                                </select>
                            </div>

                            <div>
                                <label class="label py-1">
                                    <span class="label-text text-xs font-semibold">
                                        مقدار
                                    </span>
                                </label>

                                <input id="filterValue"
                                       class="input input-bordered w-full"
                                       placeholder="مقدار فیلتر..."
                                       autocomplete="off"
                                       disabled />
                            </div>

                        </div>

                        <div class="flex justify-end pt-1">

                            <button type="button"
                                    id="addFilterRule"
                                    class="btn btn-sm btn-outline"
                                    disabled>

                                + افزودن شرط

                            </button>

                        </div>

                    </div>
                </div>

            </section>

            <div class="divider my-5"></div>

            <!-- Sorting -->
            <section>

                <div class="mb-3">

                    <h4 class="font-bold">
                        مرتب‌سازی
                    </h4>

                    <p class="mt-1 text-xs text-base-content/50">
                        نتیجه را بر اساس یکی از ستون‌های قابل مرتب‌سازی نمایش دهید.
                    </p>

                </div>

                <div class="grid gap-3 sm:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">

                    <select id="sortColumn"
                            class="select select-bordered w-full">
                        <option value="">
                            بدون مرتب‌سازی
                        </option>
                    </select>

                    <select id="sortDirection"
                            class="select select-bordered w-full">
                        <option value="asc">
                            صعودی
                        </option>

                        <option value="desc">
                            نزولی
                        </option>
                    </select>

                </div>

            </section>

        </div>

        <!-- Footer -->
        <div class="flex shrink-0 items-center justify-between gap-2 border-t border-base-300 bg-base-100 px-5 py-4">

            <button type="button"
                    id="resetFilterPanel"
                    class="btn btn-sm btn-ghost">
                بازنشانی
            </button>

            <div class="flex gap-2">

                <button type="button"
                        class="btn btn-sm btn-ghost"
                        onclick="document.getElementById('reportFilterPanel').close()">
                    انصراف
                </button>

                <button type="button"
                        id="applyFilterPanel"
                        class="btn btn-sm btn-primary">
                    اعمال فیلتر
                </button>

            </div>

        </div>

    </div>

    <form method="dialog"
          class="modal-backdrop">
        <button>بستن</button>
    </form>

</dialog>
