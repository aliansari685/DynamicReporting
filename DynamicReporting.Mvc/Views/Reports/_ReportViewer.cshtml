@using DynamicReporting.Mvc.ViewModels
@model ReportsIndexVm

@{
    var tableDisplayNames =
        ViewBag.TableDisplayNames as IReadOnlyDictionary<string, string>
        ?? new Dictionary<string, string>();
}

<section class="card min-w-0 bg-base-100 shadow-sm">

    @if (Model.SelectedReport is not null)
    {
        <div class="card-body">

            <!-- Report Header -->
            <div class="flex flex-col gap-4 border-b border-base-300 pb-5 lg:flex-row lg:items-center lg:justify-between">

                <div>
                    <div class="flex flex-wrap items-center gap-2">

                        <h2 class="text-2xl font-bold">
                            @Model.SelectedReport.Name
                        </h2>

                        @if (Model.SelectedReport.IsDefault)
                        {
                            <span class="badge badge-primary">
                                پیش‌فرض
                            </span>
                        }

                    </div>

                    <p class="mt-2 text-sm text-base-content/50">
                        جدول پایه:
                        <span class="font-semibold">
                            @tableDisplayNames.GetValueOrDefault(
                                Model.SelectedReport.BaseTable,
                                Model.SelectedReport.BaseTable)
                        </span>
                    </p>
                </div>

                <!-- Actions -->
                <div class="flex flex-wrap gap-2">

                    <button class="btn btn-sm btn-outline"
                            onclick="openEditModal(@Model.SelectedReport.Id)">
                        ویرایش
                    </button>

                    <button class="btn btn-sm btn-error btn-outline"
                            onclick="deleteReport(@Model.SelectedReport.Id)">
                        حذف
                    </button>

                    <!-- Export -->
                    <div class="dropdown dropdown-end">

                        <button tabindex="0"
                                type="button"
                                class="btn btn-sm btn-secondary">

                            خروجی

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 class="h-4 w-4"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor">

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="m6 9 6 6 6-6" />

                            </svg>

                        </button>

                        <ul tabindex="0"
                            class="dropdown-content menu z-[10] mt-2 w-40 rounded-box bg-base-100 p-2 shadow">

                            <li>
                                <button type="button"
                                        onclick="exportReport(@Model.SelectedReport.Id, 'excel')">
                                    Excel
                                </button>
                            </li>

                            <li>
                                <button type="button"
                                        onclick="exportReport(@Model.SelectedReport.Id, 'pdf')">
                                    PDF
                                </button>
                            </li>

                            <li>
                                <button type="button"
                                        onclick="exportReport(@Model.SelectedReport.Id, 'csv')">
                                    CSV
                                </button>
                            </li>

                        </ul>
                    </div>
                </div>
            </div>

            <!-- Filter & Sort Toolbar -->
            <div class="mt-5 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-base-300 bg-base-200/60 p-3">

                <div class="flex min-w-0 flex-wrap items-center gap-2">

                    <button type="button"
                            id="openFilterPanel"
                            class="btn btn-sm btn-primary"
                            onclick="openFilterPanel()">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             class="h-4 w-4"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke="currentColor">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M3 5h18M6 12h12M10 19h4" />

                        </svg>

                        فیلتر و مرتب‌سازی
                    </button>

                    <span id="activeFilterCount"
                          class="badge badge-primary hidden">
                        0
                    </span>

                    <div id="activeFilterSummary"
                         class="flex min-w-0 flex-wrap gap-2">
                    </div>
                </div>

                <span id="reportStatus"
                      class="badge badge-ghost shrink-0">
                    آماده
                </span>
            </div>

            <!-- Grid -->
            <div class="mt-6">

                <div id="reportGridContainer"
                     class="relative w-full">

                    <!-- Grid loading overlay -->
                    <div id="reportGridLoading"
                         class="absolute inset-0 z-20 hidden items-center justify-center rounded-xl bg-base-100/70 backdrop-blur-[2px]">

                        <div class="flex flex-col items-center gap-3 rounded-2xl bg-base-100 px-8 py-6 shadow-lg">

                            <span class="loading loading-spinner loading-lg text-primary"></span>

                            <span class="text-sm font-semibold">
                                در حال دریافت اطلاعات...
                            </span>

                        </div>

                    </div>

                    <div class="w-full overflow-x-auto rounded-xl border border-base-300">

                        <table class="table table-zebra w-full min-w-max">

                            <thead id="reportTableHead">
                            </thead>

                            <tbody id="reportTableBody">

                            <tr>
                                <td class="py-12 text-center">

                                    <span class="loading loading-spinner loading-lg">
                                    </span>

                                </td>
                            </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

                <!-- Pagination -->
                <div class="mt-4 flex items-center justify-between">

                    <button id="previousPage"
                            class="btn btn-sm btn-outline"
                            onclick="changePage(-1)">
                        قبلی
                    </button>

                    <span id="pageInfo"
                          class="text-sm text-base-content/60">
                        صفحه 1
                    </span>

                    <button id="nextPage"
                            class="btn btn-sm btn-outline"
                            onclick="changePage(1)">
                        بعدی
                    </button>

                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card-body flex min-h-[500px] items-center justify-center text-center">

            <div>

                <div class="mx-auto mb-5 flex h-20 w-20 items-center justify-center rounded-full bg-primary/10 text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         class="h-10 w-10"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke="currentColor">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h10a2 2 0 012 2v12a2 2 0 01-2 2z" />

                    </svg>
                </div>

                <h2 class="text-2xl font-bold">
                    گزارشی انتخاب نشده است
                </h2>

                <p class="mt-2 text-base-content/60">
                    از لیست سمت راست یک گزارش انتخاب کنید.
                </p>

            </div>
        </div>
    }

</section>
