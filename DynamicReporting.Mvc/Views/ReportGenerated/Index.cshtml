@{
    ViewData["Title"] = "گزارش‌های ایجاد شده";
}

<div class="container mx-auto max-w-6xl px-4 py-8">

    <div class="mb-6">
        <h1 class="text-3xl font-bold">
            گزارش‌های ایجاد شده
        </h1>

        <p class="mt-2 text-sm text-base-content/60">
            گزارش‌های تولید شده را مشاهده، دانلود یا حذف کنید.
        </p>
    </div>

    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">

            <div class="mb-5 flex flex-wrap items-center gap-3">

                <label for="generatedReportStatusFilter"
                       class="font-semibold">
                    وضعیت:
                </label>

                <select id="generatedReportStatusFilter"
                        class="select select-bordered">

                    <option value="">
                        همه وضعیت‌ها
                    </option>

                </select>

            </div>

            <div id="generatedReportsContainer">

                <div class="py-10 text-center">
                    <span class="loading loading-spinner loading-lg"></span>
                </div>

            </div>

            <div id="generatedReportsPagination"
                 class="mt-6 flex justify-center">
            </div>

        </div>
    </div>

</div>

<script>
    window.reportGeneratedPage = {
        generatedReports:
            '@Url.Action("GeneratedReports", "ReportGenerated")',

        downloadGeneratedReport:
            '@Url.Action("DownloadGeneratedReport", "ReportGenerated")',

        deleteGeneratedReport:
            '@Url.Action("DeleteGeneratedReport", "ReportGenerated")'
    };
</script>

@section Scripts {

    <script type="module"
            src="~/js/report-generated/index.js"
            asp-append-version="true">
    </script>

}